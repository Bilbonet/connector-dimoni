<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_dimoni_product_import_wizard_form" model="ir.ui.view">
        <field name="name">dimoni.product.import.wizard.form</field>
        <field name="model">dimoni.product.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import product from Dimoni">
                <group>
                    <field name="backend_id" />
                    <field name="product_code" />
                </group>
                <footer>
                    <button
                        name="action_import"
                        string="Import"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
