<odoo>
    <record id="view_res_partner_form_dimoni_connector" model="ir.ui.view">
        <field name="name">res.partner.form.dimoni.connector</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <field name="dimoni_binding_ids" invisible="1" />
                <button
                    name="action_open_dimoni_partners"
                    class="oe_stat_button"
                    icon="fa-chain"
                    type="object"
                    string="Dimoni"
                    groups="connector.group_connector_manager"
                    invisible="not dimoni_binding_ids"
                />
            </div>
            <xpath expr="/form/sheet" position="before">
                <header>
                    <button
                        name="action_refresh_dimoni_partner"
                        string=" Dimoni"
                        type="object"
                        class="btn-primary"
                        icon="fa-refresh"
                        groups="connector.group_connector_manager"
                        invisible="not dimoni_binding_ids"
                    />
                </header>
            </xpath>
        </field>
    </record>
</odoo>
