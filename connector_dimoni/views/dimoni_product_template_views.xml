<odoo>
    <record id="view_dimoni_product_template_search" model="ir.ui.view">
        <field name="name">dimoni.product.template.search</field>
        <field name="model">dimoni.product.template</field>
        <field name="arch" type="xml">
            <search string="Search Dimoni Products">
                <field name="external_id" />
                <field name="default_code" />
                <field name="name" />
                <field name="odoo_id" />
                <filter
                    name="company"
                    string="Company"
                    context="{'group_by': 'company_id'}"
                />
                <filter
                    name="backend"
                    string="Backend"
                    context="{'group_by': 'backend_id'}"
                />
            </search>
        </field>
    </record>

    <record id="view_dimoni_product_template_list" model="ir.ui.view">
        <field name="name">dimoni.product.template.list</field>
        <field name="model">dimoni.product.template</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button
                        name="action_open_import_wizard"
                        string="Import product"
                        type="object"
                        class="btn-primary"
                        groups="connector.group_connector_manager"
                        display="always"
                    />
                </header>
                <field name="external_id" />
                <field name="odoo_id" />
                <field name="sync_date" />
                <field name="backend_id" optional="hide" />
                <field
                    name="company_id"
                    optional="hide"
                    groups="base.group_multi_company"
                />
            </list>
        </field>
    </record>

    <record id="view_dimoni_product_template_form" model="ir.ui.view">
        <field name="name">dimoni.product.template.form</field>
        <field name="model">dimoni.product.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_refresh"
                        type="object"
                        string="Refresh"
                        class="oe_highlight"
                        icon="fa-refresh"
                        help="Fetch the latest product data from Dimoni using the internal reference."
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="external_id" />
                            <field name="odoo_id" />
                        </group>
                        <group>
                            <field name="sync_date" />
                            <field name="backend_id" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Raw Data" invisible="not raw_payload">
                            <field
                                name="raw_payload"
                                widget="ace"
                                readonly="1"
                                options="{'language': 'json', 'tabSize': 2}"
                            />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dimoni_product_template" model="ir.actions.act_window">
        <field name="name">Dimoni Products</field>
        <field name="res_model">dimoni.product.template</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Dimoni products found
            </p>
            <p>
                Import a product from a backend to create the first binding.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_dimoni_product_template"
        name="Products"
        parent="menu_dimoni_connector_root"
        action="action_dimoni_product_template"
        sequence="30"
    />
</odoo>
