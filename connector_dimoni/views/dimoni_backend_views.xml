<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_dimoni_backend_list" model="ir.ui.view">
        <field name="name">dimoni.backend.list</field>
        <field name="model">dimoni.backend</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="dbsource_id" />
                <field name="dimoni_company_id" optional="hide" />
                <field name="dimoni_grp_id" />
                <field name="active" widget="boolean_toggle" optional="hide" />
                <field name="default" widget="boolean_toggle" optional="hide" />
                <field
                    name="company_id"
                    optional="hide"
                    groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_dimoni_backend_form" model="ir.ui.view">
        <field name="name">dimoni.backend.form</field>
        <field name="model">dimoni.backend</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_import_companies"
                        string="Import companies"
                        type="object"
                        class="btn-secondary"
                        invisible="not id or not dbsource_id"
                    />
                    <button
                        name="action_open_product_import_wizard"
                        string="Import product"
                        type="object"
                        class="btn-primary"
                        invisible="not id or not dimoni_grp_id"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="dbsource_id" />
                            <field
                                name="dimoni_company_id"
                                domain="[('backend_id', '=', id)]"
                                options="{'no_create': True}"
                            />
                            <field name="dimoni_grp_id" readonly="1" />
                            <field name="default" widget="boolean_toggle" />
                        </group>
                        <group>
                            <field name="store_raw_payload" widget="boolean_toggle" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                widget="selection"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dimoni_backend" model="ir.actions.act_window">
        <field name="name">Dimoni Backends</field>
        <field name="res_model">dimoni.backend</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem 
        id="menu_dimoni_connector_root" 
        name="Dimoni Connector"
        parent="connector.menu_connector_root"
        sequence="10"
    />
    <menuitem
        id="menu_dimoni_backend"
        name="Backends"
        parent="menu_dimoni_connector_root"
        action="action_dimoni_backend"
        sequence="10"
    />
</odoo>
