<odoo>
    <record id="view_dimoni_res_partner_search" model="ir.ui.view">
        <field name="name">dimoni.res.partner.search</field>
        <field name="model">dimoni.res.partner</field>
        <field name="arch" type="xml">
            <search string="Search Dimoni Partners">
                <field name="external_id" />
                <field name="ref" />
                <field name="name" />
                <field name="vat" />
                <field name="odoo_id" />
                <filter
                    name="company"
                    string="Company"
                    context="{'group_by': 'company_id'}"
                />
                <filter
                    name="backend"
                    string="Backend"
                    context="{'group_by': 'backend_id'}"
                />
            </search>
        </field>
    </record>

    <record id="view_dimoni_res_partner_list" model="ir.ui.view">
        <field name="name">dimoni.res.partner.list</field>
        <field name="model">dimoni.res.partner</field>
        <field name="arch" type="xml">
            <list decoration-muted="not binding_active">
                <header>
                    <button
                        name="%(connector_dimoni.action_dimoni_partner_import_wizard)d"
                        string="Import partner"
                        type="action"
                        class="btn-primary"
                        groups="connector.group_connector_manager"
                        display="always"
                    />
                </header>
                <field name="ref" />
                <field name="odoo_id" />
                <field name="sync_date" />
                <field name="backend_id" optional="hide" />
                <field
                    name="binding_active"
                    widget="boolean_toggle"
                    optional="show"
                    groups="connector.group_connector_manager"
                />
                <field
                    name="company_id"
                    optional="hide"
                    groups="base.group_multi_company"
                />
            </list>
        </field>
    </record>

    <record id="view_dimoni_res_partner_form" model="ir.ui.view">
        <field name="name">dimoni.res.partner.form</field>
        <field name="model">dimoni.res.partner</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_refresh"
                        type="object"
                        string="Refresh"
                        class="oe_highlight"
                        icon="fa-refresh"
                        help="Fetch the latest partner data from Dimoni."
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="external_id" />
                            <field name="odoo_id" />
                        </group>
                        <group>
                            <field name="sync_date" />
                            <field name="backend_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Raw Data" invisible="not raw_payload">
                            <field
                                name="raw_payload"
                                widget="ace"
                                readonly="1"
                                options="{'language': 'json', 'tabSize': 2}"
                            />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dimoni_res_partner" model="ir.actions.act_window">
        <field name="name">Dimoni Partners</field>
        <field name="res_model">dimoni.res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Dimoni partners found
            </p>
            <p>
                Import a partner from a backend to create the first binding.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_dimoni_res_partner"
        name="Partners"
        parent="menu_dimoni_connector_root"
        action="action_dimoni_res_partner"
        sequence="40"
    />
</odoo>
