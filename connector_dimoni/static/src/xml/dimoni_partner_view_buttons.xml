<templates xml:space="preserve">
    <t t-name="connector_dimoni.DimoniPartnerList.Buttons" t-inherit="web.ListView">
        <xpath
            expr="//Layout/t[@t-set-slot='control-panel-create-button']"
            position="inside"
        >
            <button
                type="button"
                class="btn btn-primary"
                t-on-click="onImportFromDimoniClick"
            >
                Dimoni Import
            </button>
        </xpath>
    </t>

    <t t-name="connector_dimoni.DimoniPartnerKanban.Buttons" t-inherit="web.KanbanView">
        <xpath
            expr="//Layout/t[@t-set-slot='control-panel-create-button']"
            position="inside"
        >
            <button
                type="button"
                class="btn btn-primary"
                t-on-click="onImportFromDimoniClick"
            >
                Dimoni Import
            </button>
        </xpath>
    </t>
</templates>
